# Shed uses this zone when resolving "today" for care schedules.
SHED_TIME_ZONE=America/New_York

# Turn on only after the Owner has bootstrapped a profile and the frontend login
# flow is deployed. When true, dashboard/task/inventory APIs require a member cookie.
SHED_AUTH_REQUIRED=false

# Direct LAN installs must leave this blank. Forwarding headers are otherwise
# caller-controlled and are ignored for login throttling. Set one of the values
# below only when Shed's origin cannot be reached except through a trusted proxy
# that strips and overwrites that exact header:
#   cf-connecting-ip | x-real-ip | x-forwarded-for
SHED_TRUSTED_PROXY_IP_HEADER=

# One-time Owner setup only. Remove this after the Owner profile is created.
# Send it as X-Shed-Bootstrap-Token to POST /api/auth/bootstrap.
SHED_BOOTSTRAP_TOKEN=replace-with-a-different-long-random-secret

# Optional read-only feed for a trusted room display. Generate a separate long
# random value; callers send it as X-Shed-Display-Token. The feed excludes
# household identities, rewards, history, completion IDs, and all write access.
SHED_DISPLAY_TOKEN=replace-with-a-separate-long-random-secret

# Host port used by Docker Compose. The container always listens on 3000.
SHED_PORT=3000

# Persistent SQLite directory. Use ../data when compose.yaml is stored in
# /mnt/user/appdata/shed/source on Unraid.
SHED_DATA_PATH=./data
