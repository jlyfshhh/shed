# Shed uses this zone when resolving "today" for care schedules.
SHED_TIME_ZONE=America/New_York

# Authentication is secure-by-default. The one-time bootstrap token below is
# still accepted until the first Head Keeper profile is created.
SHED_AUTH_REQUIRED=true

# Direct LAN installs must leave this blank. Forwarding headers are otherwise
# caller-controlled and are ignored for login throttling. Set one of the values
# below only when Shed's origin cannot be reached except through a trusted proxy
# that strips and overwrites that exact header:
#   cf-connecting-ip | x-real-ip | x-forwarded-for
SHED_TRUSTED_PROXY_IP_HEADER=

# One-time Owner setup only. Remove this after the Owner profile is created.
# Send it as X-Shed-Bootstrap-Token to POST /api/auth/bootstrap.
SHED_BOOTSTRAP_TOKEN=replace-with-a-different-long-random-secret

# Optional read-only feed for a trusted room display. Generate a separate long
# random value; callers send it as X-Shed-Display-Token. The feed excludes
# household identities, rewards, history, completion IDs, and all write access.
SHED_DISPLAY_TOKEN=replace-with-a-separate-long-random-secret

# Host port used by Docker Compose. The container always listens on 3000.
SHED_PORT=3000

# Persistent SQLite directory. Use ../data when compose.yaml is stored in
# /mnt/user/appdata/shed/source on Unraid.
SHED_DATA_PATH=./data

# Host-side SQLite snapshot destination and retention window. The backup script
# reads these values directly from this file; it never executes shell from it.
SHED_BACKUP_PATH=./backups
SHED_BACKUP_KEEP=30

# Keep this false for ordinary installs. Set it to true only when the data or
# backup directory is a dedicated, pre-created path outside the Shed install
# (for example an Unraid appdata mount). The installer verifies an external data
# directory's ownership but never recursively changes an external tree for you.
SHED_ALLOW_EXTERNAL_PATHS=false

# Shed runs without root. The installer fills these with the account that owns
# the install so its private SQLite files and backups remain accessible to that
# account. A direct Compose install must replace these with `id -u` and `id -g`,
# or explicitly make both bind-mounted directories belong to uid/gid 10001.
SHED_UID=10001
SHED_GID=10001

# Container safety limits. Raise these only for an unusually large household.
SHED_MEMORY_LIMIT=1g
SHED_CPU_LIMIT=2.0
SHED_PIDS_LIMIT=256
